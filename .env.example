# Models (ChatGPT OAuth subscription tier; embeddings not available)
MODEL_GENERATOR=gpt-4o-mini
MODEL_REVIEWER=gpt-4o
MODEL_EMBEDDING=text-embedding-3-small

# OAuth token file (empty = default: $XDG_CONFIG_HOME/english-learning/auth.json
# or ~/.config/english-learning/auth.json)
OAUTH_TOKEN_PATH=

# DB paths
APP_DB_PATH=./data/app.db
VOCAB_DB_PATH=./data/vocab.db

# Server
HTTP_ADDR=127.0.0.1:8080
ALLOWED_ORIGIN=http://127.0.0.1:5173

# Logging
LOG_LEVEL=info
